import * as THREE from "three";
import { mergeGeometries } from "three/examples/jsm/utils/BufferGeometryUtils.js";
import Point from "../../../utils/Point";
import { paintGeometry } from "../scene/sculpt";
import { containsPoint, TabletopRegion, TabletopSnapshot } from "../model";
import WorldHeightfield, { worldSeaLevel } from "./WorldHeightfield";
import { wildlingGeometry } from "./WorldWildlingGeometry";

interface CampSite extends Point { height: number; yaw: number; }
export interface NorthernClearing extends Point { radius: number; }
const random = (i: number, salt: number): number => { const value = Math.sin(i * 127.1 + salt * 311.7) * 43758.5453; return value - Math.floor(value); };

// The public threat track, represented by illustrative camps. Strength points
// are NOT a population, army size, attack timetable or White Walker count.
// No log playback, Unit objects, picking, lights, audio or independent RAF.
// At k === 20 only: up to 12 camps searched on the streamed terrain, 5–8 turf-long
// huts each (dormant at threat 0), 0–12 threat → 0–8 lit fires (bible §3.10), no
// decorative human figures. k = 1 path stays bit-identical to P2b.
export default class WorldWildlings {
  readonly group = new THREE.Group();
  private sites: CampSite[] = [];
  private material = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.94 });
  private fireTime = { value: 0 };
  private cinemaGlow = { value: 1 };
  private hearths: THREE.InstancedMesh;
  private camps: THREE.InstancedMesh;
  private people: THREE.InstancedMesh;
  private turf?: THREE.InstancedMesh;
  private smokeTexture: THREE.CanvasTexture;
  private smoke: THREE.InstancedMesh;
  private labelCanvas = document.createElement("canvas");
  private labelTexture: THREE.CanvasTexture;
  private label: THREE.Sprite;
  private labelAnchor = new THREE.Vector3();
  private labelClip = new THREE.Vector3();
  private object = new THREE.Object3D();
  private frustum = new THREE.Frustum();
  private projection = new THREE.Matrix4();
  private point = new THREE.Vector3();
  private sphere = { center: this.point, radius: 0.24 };
  private clock = 0;
  private last = 0;
  private paused = false;
  private strength = -1;
  private lit = 0;
  private readonly worldScale20: boolean;
  private readonly siteCap: number;
  private readonly fireCap: number;
  /** World ×20: camps are searched on the streamed terrain; WorldNorth keeps this list (updated in place). */
  private clearingList: NorthernClearing[] = [];
  private seated: unknown = undefined;
  private timer?: number;
  private regions: TabletopRegion[];
  readonly anchors: { id: string; point: Point }[] = [];

  constructor(private field: WorldHeightfield, regions: TabletopRegion[], private groundAt: (point: Point) => number) {
    this.group.name = "Public wildling camps";
    this.regions = regions;
    this.worldScale20 = field.frame.k === 20;
    this.siteCap = this.worldScale20 ? 12 : 6;
    this.fireCap = this.worldScale20 ? 8 : 6;
    this.hearths = new THREE.InstancedMesh(wildlingGeometry("hearth"), this.material, this.siteCap);
    this.camps = new THREE.InstancedMesh(wildlingGeometry("camp"), this.material, this.fireCap);
    this.people = new THREE.InstancedMesh(wildlingGeometry("person"), this.material, this.worldScale20 ? 1 : 24);
    this.material.onBeforeCompile = shader => {
      shader.uniforms.campTime = this.fireTime;
      shader.uniforms.campCinema = this.cinemaGlow;
      shader.vertexShader = "attribute float campFire; varying float vCampFire;\n" + shader.vertexShader;
      shader.vertexShader = shader.vertexShader.replace("#include <begin_vertex>", "#include <begin_vertex>\nvCampFire = campFire;");
      shader.fragmentShader = "uniform float campTime; uniform float campCinema; varying float vCampFire;\n" + shader.fragmentShader;
      shader.fragmentShader = shader.fragmentShader.replace("#include <emissivemap_fragment>", "#include <emissivemap_fragment>\ntotalEmissiveRadiance += vec3(1.8, 0.47, 0.07) * vCampFire * campCinema * (0.94 + 0.06 * sin(campTime * 5.0));");
    };
    this.material.customProgramCacheKey = () => "public-wildling-camps-cinema-v1";
    const canvas = document.createElement("canvas");
    canvas.width = canvas.height = 64;
    const context = canvas.getContext("2d");
    if (context) {
      const gradient = context.createRadialGradient(32, 32, 0, 32, 32, 32);
      gradient.addColorStop(0, "rgba(166,172,174,0.46)");
      gradient.addColorStop(0.45, "rgba(151,159,162,0.24)");
      gradient.addColorStop(1, "rgba(151,159,162,0)");
      context.fillStyle = gradient; context.fillRect(0, 0, 64, 64);
    }
    this.smokeTexture = new THREE.CanvasTexture(canvas);
    this.smoke = new THREE.InstancedMesh(new THREE.PlaneGeometry(1, 1), new THREE.MeshBasicMaterial({ map: this.smokeTexture, transparent: true, depthWrite: false, opacity: 0.65 }), this.fireCap * 3);
    this.labelCanvas.width = 640; this.labelCanvas.height = 168;
    this.labelTexture = new THREE.CanvasTexture(this.labelCanvas);
    const labelMaterial = new THREE.SpriteMaterial({ map: this.labelTexture, transparent: true, depthWrite: false, toneMapped: false }) as THREE.SpriteMaterial & { sizeAttenuation: boolean; fog: boolean };
    labelMaterial.sizeAttenuation = false;
    labelMaterial.fog = false;
    this.label = new THREE.Sprite(labelMaterial);
    this.label.name = "Wildling threat · public strength points";
    this.label.renderOrder = 5;
    // ×20: the sites need the CDLOD sampler (render → reseat); k = 1 unchanged.
    if (!this.worldScale20) this.findSites(regions);
    [this.hearths, this.camps, this.people, this.smoke].forEach(mesh => {
      mesh.count = 0;
      mesh.frustumCulled = false;
      mesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
      this.group.add(mesh);
    });
    this.sites.forEach((site, i) => {
      this.place(site, 0, 0);
      this.hearths.setMatrixAt(i, this.object.matrix);
    });
    this.hearths.count = this.sites.length;
    this.hearths.instanceMatrix.needsUpdate = true;
    this.anchorLabel();
  }

  private anchorLabel(): void {
    const field = this.field;
    if (this.sites.length) {
      const center = this.sites.reduce((sum, site) => ({ x: sum.x + site.x / this.sites.length, y: sum.y + site.y / this.sites.length }), { x: 0, y: 0 });
      this.label.position.set(field.frame.len(center.x - field.width / 2) + field.frame.len(170), Math.max(...this.sites.map(site => site.height)) + 0.40, field.frame.len(center.y - field.height / 2));
      this.labelAnchor.copy(this.label.position);
      this.group.add(this.label);
    }
  }

  private findSites(regions: TabletopRegion[]): void {
    const wall = regions.find(entry => entry.region.id == "castle-black");
    if (!wall) return;
    const center = (Math.min(...wall.points.map(point => point.x)) + Math.max(...wall.points.map(point => point.x))) / 2;
    // Most candidates are beyond the playable polygons. Reject their bounds
    // before the exact polygon test at every footprint sample. Same acceptance.
    const bounds = regions.map(entry => ({ points: entry.points,
      left: Math.min(...entry.points.map(p => p.x)), right: Math.max(...entry.points.map(p => p.x)),
      top: Math.min(...entry.points.map(p => p.y)), bottom: Math.max(...entry.points.map(p => p.y)) }));
    const slots = regions.flatMap(({ region }) => [region.unitSlot.point, region.orderSlot, region.nameSlot, region.powerTokenSlot]);
    for (let i = 0; i < 1200 && this.sites.length < 6; i++) {
      const point = { x: center - 130 + random(i, 41) * 165, y: -100 - random(i, 53) * 195 };
      if (this.sites.some(site => Math.hypot(point.x - site.x, point.y - site.y) < 40)) continue;
      if (slots.some(slot => Math.hypot(point.x - slot.x, point.y - slot.y) < 55)) continue;
      const heights: number[] = [];
      let safe = true;
      // Check the entire prop footprint against BOTH terrain resolutions and
      // the far 12px mesh. Roots overlap the small residual slope; no pad or
      // terrain height is invented to obtain a site.
      for (let y = -12; y <= 12 && safe; y += 3) for (let x = -12; x <= 12 && safe; x += 3) {
        const sample = { x: point.x + x, y: point.y + y };
        if (bounds.some(entry => sample.x >= entry.left && sample.x <= entry.right && sample.y >= entry.top && sample.y <= entry.bottom && containsPoint(entry.points, sample)) || this.field.rivers?.containsWater(sample)) { safe = false; break; }
        for (const step of [0.5, 1, 2]) heights.push(this.field.meshHeightAt(sample, step));
      }
      if (!safe) continue;
      const min = Math.min(...heights), max = Math.max(...heights);
      if (min < worldSeaLevel + 0.09 || max - min > 0.018) continue;
      this.sites.push({ ...point, height: max, yaw: random(i, 61) * Math.PI * 2 });
    }
    this.sites.sort((a, b) => a.y - b.y);
  }

  /** Director progress of an already-public attack. Camp COUNT remains a
   * function of snapshot.wildlingStrength exclusively (never cinematic time). */
  cinematicAttack(progress: number | null, victory?: boolean): void {
    this.cinemaGlow.value = progress == null ? 1 : victory === true ? 1 - Math.max(0, Math.min(1, progress)) * 0.65 : 1 + Math.sin(Math.max(0, Math.min(1, progress)) * Math.PI) * 0.3;
  }

  /**
   * World ×20 only: search the camps on the streamed terrain (same seeded
   * candidates and public exclusions as k = 1, footprint checked on the
   * sampler), then seat hearths, turf-long huts, the lit fires and the label.
   * One task when the sampler arrives or changes; never per frame.
   */
  private reseat(): void {
    const field = this.field, frame = field.frame, metres = frame.metresPerUnit;
    const wall = this.regions.find(entry => entry.region.id == "castle-black");
    this.sites = [];
    if (wall) {
      const center = (Math.min(...wall.points.map(point => point.x)) + Math.max(...wall.points.map(point => point.x))) / 2;
      const slots = this.regions.flatMap(({ region }) => [region.unitSlot.point, region.orderSlot, region.nameSlot, region.powerTokenSlot]);
      const altitude = (p: Point): number => (field.surfaceAt(p) - worldSeaLevel) * metres;
      for (let i = 0; i < 2400 && this.sites.length < this.siteCap; i++) {
        const point = { x: center - 130 + random(i, 41) * 220, y: -100 - random(i, 53) * 320 };
        if (this.sites.some(site => Math.hypot(point.x - site.x, point.y - site.y) < 32)) continue;
        if (slots.some(slot => Math.hypot(point.x - slot.x, point.y - slot.y) < 55)) continue;
        // A ~60 m camp footprint on dry, gentle public ground (board px; 1 px = 10 m).
        const heights: number[] = [];
        let safe = true;
        for (let y = -6; y <= 6 && safe; y += 3) for (let x = -6; x <= 6 && safe; x += 3) {
          const sample = { x: point.x + x, y: point.y + y };
          if (this.regions.some(entry => containsPoint(entry.points, sample)) || field.rivers?.containsWater(sample)) safe = false;
          else heights.push(altitude(sample));
        }
        if (!safe || Math.min(...heights) < 6 || Math.max(...heights) > 520 || Math.max(...heights) - Math.min(...heights) > 14) continue;
        this.sites.push({ ...point, height: field.surfaceAt(point), yaw: random(i, 61) * Math.PI * 2 });
      }
      this.sites.sort((a, b) => a.y - b.y);
    }
    this.sites.forEach((site, i) => { this.place(site, 0, 0); this.hearths.setMatrixAt(i, this.object.matrix); });
    this.hearths.count = this.sites.length;
    this.hearths.instanceMatrix.needsUpdate = true;
    // Turf-long huts (K1), 5–8 per camp, around the hearth; dormant at threat 0.
    if (!this.turf) {
      this.turf = new THREE.InstancedMesh(this.turfGeometry(), this.material, this.siteCap * 8);
      this.turf.frustumCulled = true;
      this.turf.castShadow = this.turf.receiveShadow = true;
      this.group.add(this.turf);
    }
    const turf = this.turf, u = frame.m(1);
    turf.count = 0;
    this.sites.forEach((site, i) => {
      const huts = 5 + Math.floor(random(i, 71) * 4);
      for (let j = 0; j < huts; j++) {
        const angle = site.yaw + j / huts * Math.PI * 2 + (random(i * 8 + j, 73) - 0.5) * 0.5, r = (15 + random(i * 8 + j, 79) * 13) * u;
        const x = Math.sin(angle) * r, z = Math.cos(angle) * r;
        this.place(site, x, z);
        this.object.position.y = field.surfaceAt(frame.boardPoint(this.object.position.x, this.object.position.z)) - frame.m(0.5);
        this.object.rotation.y = site.yaw + angle + Math.PI / 2;
        this.object.scale.setScalar(0.8 + random(i * 8 + j, 83) * 0.4);
        this.object.updateMatrix();
        turf.setMatrixAt(turf.count++, this.object.matrix);
      }
    });
    turf.instanceMatrix.needsUpdate = true;
    turf.boundingSphere = null;
    this.clearingList.length = 0;
    this.anchors.length = 0;
    this.sites.forEach((site, i) => {
      this.clearingList.push({ x: site.x, y: site.y, radius: 7 }); // frame: map — 70 m camp clearing at k = 20
      this.anchors.push({ id: `wildling-camp-${i}`, point: { x: site.x, y: site.y } });
    });
    this.label.parent?.remove(this.label);
    this.anchorLabel();
    this.light();
  }

  private turfGeometry(): THREE.BufferGeometry {
    // Original turf-long hut, physical metres (object space): sod walls, a
    // low turf roof and a dark door. Not a unit base; no figures.
    const u = this.field.frame.m(1);
    const parts: THREE.BufferGeometry[] = [];
    const add = (geometry: THREE.BufferGeometry, color: string): void => {
      const part = geometry.index ? geometry.toNonIndexed() : geometry;
      if (part != geometry) geometry.dispose();
      part.scale(u, u, u);
      part.deleteAttribute("uv");
      paintGeometry(part, color);
      part.setAttribute("campFire", new THREE.Float32BufferAttribute(new Float32Array(part.getAttribute("position").count), 1));
      parts.push(part);
    };
    add(new THREE.BoxGeometry(10, 2.4, 5).translate(0, 0.9, 0), "#4d4234");
    const roof = new THREE.BufferGeometry(), l = 5.4, w = 3, y = 2.1, r = 2.2;
    roof.setAttribute("position", new THREE.Float32BufferAttribute([
      -l, y, -w, l, y + r, 0, l, y, -w, -l, y, -w, -l, y + r, 0, l, y + r, 0,
      -l, y, w, l, y, w, l, y + r, 0, -l, y, w, l, y + r, 0, -l, y + r, 0,
      -l, y, -w, -l, y, w, -l, y + r, 0, l, y, -w, l, y + r, 0, l, y, w
    ], 3));
    roof.computeVertexNormals();
    add(roof, "#5b583c");
    add(new THREE.BoxGeometry(0.2, 1.7, 1.1).translate(5.02, 0.85, 0), "#211d19");
    const geometry = mergeGeometries(parts);
    parts.forEach(part => part.dispose());
    if (!geometry) throw new Error("Could not assemble turf-long shelter");
    return geometry;
  }

  clearings(): NorthernClearing[] {
    // ×20: one live list, filled once the camps are seated on the streamed terrain.
    return this.worldScale20 ? this.clearingList : this.sites.map(site => ({ x: site.x, y: site.y, radius: 18 }));
  }

  /** Bible §3.10: with public strength ≥ 8, High frost can deepen (integrator hook). */
  frostAccent(): boolean {
    return this.strength >= 8;
  }

  update(snapshot: TabletopSnapshot): void {
    this.paused = !!snapshot.presentationPaused;
    const strength = Math.max(0, Math.min(12, snapshot.wildlingStrength));
    if (this.strength == strength) return;
    this.strength = strength;
    this.light();
  }

  /** Lit fires from the public threat only: k = 1 ceil(strength / 2); ×20 0–12 → 0–8 (bible §3.10). */
  private light(): void {
    const strength = Math.max(0, this.strength);
    // k = 1: ceil(strength/2) capped by site count (unchanged).
    // k = 20: 0–12 → 0–8 lit hearths/camps (bible §3.10).
    this.lit = this.worldScale20
      ? Math.min(this.fireCap, Math.round(strength * this.fireCap / 12))
      : Math.min(this.sites.length, Math.ceil(strength / 2));
    this.camps.count = this.lit;
    this.sites.slice(0, this.lit).forEach((site, i) => {
      this.place(site, 0, 0);
      // ×20: a bonfire that reads from the close band (still no figures).
      if (this.worldScale20) { this.object.scale.setScalar(1.6); this.object.updateMatrix(); }
      this.camps.setMatrixAt(i, this.object.matrix);
    });
    this.camps.instanceMatrix.needsUpdate = true;
    const context = this.labelCanvas.getContext("2d");
    if (context) {
      context.clearRect(0, 0, 640, 168);
      context.fillStyle = "rgba(12,22,29,0.94)";
      context.fillRect(0, 0, 640, 168);
      context.fillStyle = "#b8c9d0"; context.textAlign = "center";
      context.font = "26px sans-serif"; context.fillText("BEYOND THE WALL", 320, 35);
      context.fillStyle = "#f0eee7"; context.font = "bold 46px sans-serif";
      context.fillText(`Wildling threat  ${strength} / 12`, 320, 89);
      context.fillStyle = "#b8c9d0"; context.font = "28px sans-serif";
      context.fillText("Strength points · illustrative camps", 320, 132);
      for (let i = 0; i < 12; i++) {
        context.fillStyle = i < strength ? "#d69c69" : "#39474f";
        context.fillRect(116 + i * 35, 150, 23, 10);
      }
      this.labelTexture.needsUpdate = true;
    }
  }

  private place(site: CampSite, x: number, z: number): void {
    const c = Math.cos(site.yaw), s = Math.sin(site.yaw);
    this.object.position.set(this.field.frame.len(site.x - this.field.width / 2) + x * c + z * s, site.height, this.field.frame.len(site.y - this.field.height / 2) - x * s + z * c);
    this.object.rotation.set(0, site.yaw, 0);
    this.object.scale.setScalar(1);
    this.object.updateMatrix();
  }

  render(now: number, camera: THREE.PerspectiveCamera, high: boolean, reduced: boolean, viewportHeight: number): boolean {
    if (this.worldScale20 && this.field.sampler && this.field.sampler !== this.seated && this.timer == undefined) {
      this.timer = window.setTimeout(() => { this.timer = undefined; this.seated = this.field.sampler; this.reseat(); }, 0);
    }
    const elapsed = this.last ? Math.max(0, Math.min(50, now - this.last)) : 0;
    this.last = now;
    if (!reduced && !this.paused) this.clock += elapsed / 1000;
    this.fireTime.value = this.clock;
    this.projection.multiplyMatrices(camera.projectionMatrix, camera.matrixWorldInverse);
    this.frustum.setFromProjectionMatrix(this.projection);
    this.people.count = this.smoke.count = 0;
    let animate = false;
    this.sites.forEach((site, i) => {
      if (i >= this.lit) return;
      this.point.set(this.field.frame.len(site.x - this.field.width / 2), site.height + 0.08, this.field.frame.len(site.y - this.field.height / 2));
      if (!(this.frustum as THREE.Frustum & { intersectsSphere(sphere: { center: THREE.Vector3; radius: number }): boolean }).intersectsSphere(this.sphere)) return;
      const distance = this.point.distanceToSquared(camera.position);
      // No continuous redraw request for sub-pixel smoke in the overview.
      if (distance < 169) animate = true;
      const near = distance < (high ? 100 : 64);
      // Bible §3.10: no decorative human figures beyond the Wall at k = 20.
      if (near && !this.worldScale20) for (let j = 0; j < (high ? 4 : 2); j++) {
        const angle = j * Math.PI / 2 + i + Math.sin(this.clock * 0.18 + j) * 0.14;
        this.place(site, Math.sin(angle) * 0.043, Math.cos(angle) * 0.043);
        this.object.position.y = this.groundAt(this.field.frame.boardPoint(this.object.position.x, this.object.position.z));
        this.object.rotation.y = site.yaw + angle + Math.PI;
        this.object.updateMatrix();
        this.people.setMatrixAt(this.people.count++, this.object.matrix);
      }
      for (let j = 0; j < (high ? 3 : 1); j++) {
        const t = (this.clock * 0.18 + j / 3 + i * 0.13) % 1;
        // ×20: a taller plume (≈ 60 m) so a lit camp reads above the forest canopy.
        const plume = this.worldScale20 ? 4 : 1;
        this.place(site, Math.sin(t * 3 + i) * 0.018 * t * plume, 0);
        this.object.position.y += (0.035 + t * 0.21) * plume;
        this.object.quaternion.copy(camera.quaternion);
        this.object.scale.setScalar((0.035 + t * 0.065) * plume);
        this.object.updateMatrix();
        this.smoke.setMatrixAt(this.smoke.count++, this.object.matrix);
      }
    });
    [this.people, this.smoke].forEach(mesh => { mesh.visible = mesh.count > 0; mesh.instanceMatrix.needsUpdate = true; });
    // Constant angular size keeps the exact public number legible in the
    // northern view without enlarging camps to pretend they are an army.
    const height = Math.max(1, viewportHeight);
    const width = height * camera.aspect;
    const labelWidth = Math.min(280, Math.max(1, width - 24));
    const unit = this.field.frame.ui(1, 1, camera.fov, height); // frame: screen — angular sprite, sizeAttenuation=false
    this.label.scale.set(labelWidth * unit, 74 * unit, 1);
    this.labelClip.copy(this.labelAnchor).project(camera);
    this.label.visible = this.sites.length > 0 && Math.abs(this.labelClip.x) < 1.25 && Math.abs(this.labelClip.y) < 1 && this.labelClip.z > -1 && this.labelClip.z < 1;
    if (this.label.visible) {
      // Keep the local annotation inside a compact viewport, but never turn an
      // off-screen northern landmark into a persistent HUD badge.
      const limit = Math.max(0, 1 - (labelWidth + 16) / width);
      this.labelClip.x = Math.max(-limit, Math.min(limit, this.labelClip.x));
      this.label.position.copy(this.labelClip.unproject(camera));
    }
    return animate && !reduced && !this.paused;
  }

  suspend(): void { this.last = 0; }

  dispose(): void {
    if (this.timer != undefined) window.clearTimeout(this.timer);
    this.group.parent?.remove(this.group);
    [this.hearths, this.camps, this.people, this.smoke, this.turf].forEach(mesh => {
      if (!mesh) return;
      mesh.dispose();
      mesh.geometry.dispose();
    });
    this.material.dispose();
    (this.smoke.material as THREE.Material).dispose();
    this.smokeTexture.dispose();
    this.label.material.dispose();
    this.labelTexture.dispose();
  }
}
