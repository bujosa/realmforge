{
  "name": "realmforge",
  "version": "0.1.0",
  "description": "Procedural low-poly medieval miniatures, castles and cities for three.js, with a visual QA gallery.",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "qa": "node qa/run.cjs"
  },
  "peerDependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "three": "0.186.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "playwright": "^1.56.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bujosa/realmforge.git"
  },
  "homepage": "https://bujosa.github.io/realmforge/",
  "bugs": {
    "url": "https://github.com/bujosa/realmforge/issues"
  },
  "keywords": [
    "threejs",
    "procedural",
    "medieval",
    "miniatures",
    "castles",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./presets/*": "./src/presets/*.ts",
    "./armies": "./src/armies/index.ts",
    "./wildlings": "./src/wildlings/index.ts",
    "./heraldry": "./src/heraldry/index.ts",
    "./heraldry/sources": "./src/heraldry/sources.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "types": "src/index.ts"
}
